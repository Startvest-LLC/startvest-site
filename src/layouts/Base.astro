---
import { SITE_NAME, SITE_URL, SITE_DESCRIPTION, AUTHOR, GA_MEASUREMENT_ID } from '../consts';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown>[];
  briefLink?: boolean;
}

const { title, description = SITE_DESCRIPTION, ogType = 'website', jsonLd = [], briefLink = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE_URL).href;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const path = Astro.url.pathname.replace(/\/$/, '');

const nav = [
  { href: '/blog', label: 'Blog' },
  { href: '/tom-pinder', label: 'About' },
  { href: '/capabilities', label: 'Capabilities' },
  { href: '/contact', label: 'Contact' },
];

const sitewide = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE_URL}/tom-pinder#person`,
    name: AUTHOR.name,
    url: AUTHOR.url,
    image: AUTHOR.image,
    jobTitle: 'Operations and Systems Engineer; AI Deployment',
    worksFor: { '@id': `${SITE_URL}/#org` },
    sameAs: [AUTHOR.linkedin, AUTHOR.github],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE_URL}/#org`,
    name: 'StartVest LLC',
    url: SITE_URL,
    email: AUTHOR.email,
    founder: { '@id': `${SITE_URL}/tom-pinder#person` },
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="StartVest blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {briefLink && <link rel="brief" href="/tom-pinder/brief.md" type="text/markdown" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary" />
    {[...sitewide, ...jsonLd].map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    {GA_MEASUREMENT_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          // No ad signals: the privacy page promises no ad trackers.
          gtag('config', id, { allow_google_signals: false, allow_ad_personalization_signals: false });
        </script>
      </>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">S</span>StartVest</a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href || path.startsWith(n.href + '/') ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>StartVest LLC. Hampstead, NC.</span>
        <a class="govcon" href="/capabilities">USMC veteran · SDVOSB / VOSB · UEI FJ4ZFNG4XS54 · CAGE 18X56</a>
        <a href={AUTHOR.linkedin}>LinkedIn</a>
        <a href={AUTHOR.github}>GitHub</a>
        <a href="/rss.xml">RSS</a>
        <a href="/privacy">Privacy</a>
      </div>
    </footer>
  </body>
</html>

// Assets-only Worker: serves the Astro build from ./dist.
// _redirects and _headers in public/ are applied by Workers static assets.
{
  "name": "startvest-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
  // Cutover only (see README). Do not enable until the pre-cutover checklist is done:
  // "routes": [
  //   { "pattern": "startvest.ai", "custom_domain": true },
  //   { "pattern": "www.startvest.ai", "custom_domain": true }
  // ]
}
